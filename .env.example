# Lab Rotation keys: copy this file to .env (git-ignored) and paste each value. Never commit .env.

# Bruin Cloud (getbruin.com)
BRUIN_API_KEY=

# Telem AI (telem.ai), starts with tlm_
TELEM_API_KEY=

# Runware (runware.ai)
RUNWARE_API_KEY=

# Glasser
GLASSER_API_KEY=

# BAND (app.band.ai): one key and ID per agent, plus the panel room
BAND_VALE_AGENT_ID=
BAND_VALE_API_KEY=
BAND_INES_AGENT_ID=
BAND_INES_API_KEY=
BAND_SAM_AGENT_ID=
BAND_SAM_API_KEY=
BAND_ROOM_ID=

# Optional
# BAND_REST_URL=
# BAND_WS_URL=
# BAND_USER_API_KEY=
# TEAMILY_API_KEY=

# Server
LAB_MOCK=0
LAB_MOCK_SPEED=1
